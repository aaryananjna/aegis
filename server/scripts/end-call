#!/usr/bin/env python3
"""End the call started by `start-call` (or the one given): both screens show "Call ended",
the mic stops and both links stop working.

    server/scripts/end-call             # the last call start-call started
    server/scripts/end-call <session>   # a specific call
"""
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

SERVER = os.environ.get("AEGIS_SERVER", "http://localhost:8000")
LAST = Path(__file__).resolve().parent.parent / ".last_call"

if len(sys.argv) > 1:
    sid = sys.argv[1]
elif LAST.exists():
    sid = LAST.read_text().strip()
else:
    sys.exit("no call to end: start one with server/scripts/start-call, or pass its id")

req = urllib.request.Request(f"{SERVER}/sessions/{sid}/end", b"", method="POST")
try:
    urllib.request.urlopen(req, timeout=10).close()
    print(f"Call {sid} ended.")
except urllib.error.HTTPError as e:
    print(f"Call {sid} was already over." if e.code == 404 else f"server said {e.code}")
except OSError:
    sys.exit(f"no server at {SERVER} (stopping the server already ended every call)")
if len(sys.argv) == 1 and LAST.exists():
    LAST.unlink()
