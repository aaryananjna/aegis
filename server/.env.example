# Copy to server/.env and fill in. Never commit .env.
DEEPGRAM_API_KEY=
# TigerDB connection string for user accounts (step 5)
TIGER_DATABASE_URL=
# Where C's screens run; used to build the elder and family links
WEB_BASE_URL=http://localhost:5173
# Password the seeded demo accounts get (python -m aegis_server.seed); 8+ characters
DEMO_PASSWORD=
# How long a family login lasts, in days
LOGIN_DAYS=7
# 1 when served over https
COOKIE_SECURE=
